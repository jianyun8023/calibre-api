# Calibre API 环境变量配置示例
# 复制此文件为 .env 并填入实际值
# 注意：.env 文件包含敏感信息，已在 .gitignore 中排除

# ==================== 基础配置 ====================
# 服务监听地址
# CALIBRE_ADDRESS=:8080

# 调试模式 (true/false)
# CALIBRE_DEBUG=false

# 临时文件目录
# CALIBRE_TMPDIR=/tmp

# ==================== Calibre Content Server ====================
# Calibre Content Server 地址（必填）
CALIBRE_CONTENT_SERVER=http://localhost:8080

# ==================== MeiliSearch 配置 ====================
# MeiliSearch 服务地址
CALIBRE_MEILISEARCH_HOST=http://localhost:7700

# MeiliSearch API Key（敏感信息）
CALIBRE_MEILISEARCH_API_KEY=your_meilisearch_api_key_here

# MeiliSearch 索引名称
# CALIBRE_MEILISEARCH_INDEX_NAME=books

# ==================== Embedding 服务配置 ====================
# Embedding 提供商: ollama 或 siliconflow
CALIBRE_EMBEDDING_PROVIDER=siliconflow

# -------- Ollama 配置 --------
# CALIBRE_EMBEDDING_OLLAMA_API_URL=http://localhost:11434
# CALIBRE_EMBEDDING_OLLAMA_MODEL=nomic-embed-text

# -------- SiliconFlow 配置 --------
CALIBRE_EMBEDDING_SILICONFLOW_API_URL=https://api.siliconflow.cn/v1/embeddings
CALIBRE_EMBEDDING_SILICONFLOW_MODEL=BAAI/bge-large-zh-v1.5
# SiliconFlow API Token（敏感信息）
CALIBRE_EMBEDDING_SILICONFLOW_API_TOKEN=your_siliconflow_api_token_here

# ==================== Qdrant 配置（已废弃，使用 MeiliSearch） ====================
# CALIBRE_QDRANT_URL=http://localhost:6333
# CALIBRE_QDRANT_COLLECTION=books
# CALIBRE_QDRANT_TIMEOUT=30

# ==================== 缓存配置 ====================
# 缓存目录（为空则使用系统默认）
# CALIBRE_CACHE_DIR=

# 缓存最大容量（GB）
# CALIBRE_CACHE_MAX_SIZE_GB=10.0

# ==================== MCP 服务配置 ====================
# 启用 MCP 服务 (true/false)
# CALIBRE_MCP_ENABLED=true

# MCP 服务器名称
# CALIBRE_MCP_SERVER_NAME=calibre-mcp-server

# MCP 协议版本
# CALIBRE_MCP_VERSION=1.2.0

# MCP 传输方式 (sse/http)
# CALIBRE_MCP_TRANSPORT=sse

# MCP SSE 端点
# CALIBRE_MCP_SSE_ENDPOINT=/mcp/sse

# MCP 消息端点
# CALIBRE_MCP_MESSAGE_ENDPOINT=/mcp/message

# MCP 超时时间（秒）
# CALIBRE_MCP_TIMEOUT=30

# ==================== 草稿管理配置 ====================
# 草稿数据库路径（为空则使用默认路径）
# CALIBRE_DRAFTS_DB_PATH=

# ==================== 说明 ====================
# 1. 环境变量优先级：.env 文件 < 系统环境变量
# 2. 配置优先级：环境变量 > config.yaml 文件 > 默认值
# 3. 所有配置项都是可选的（除了 CALIBRE_CONTENT_SERVER）
# 4. 敏感信息（API Key、Token）建议通过环境变量配置
# 5. 嵌套配置使用下划线连接，如：CALIBRE_MEILISEARCH_API_KEY
