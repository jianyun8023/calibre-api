{
  "template": "spec-template.md",
  "specsDir": "specs",
  "structure": {
    "pattern": "flat",
    "prefix": "",
    "dateFormat": "YYYYMMDD",
    "sequenceDigits": 3,
    "defaultFile": "README.md"
  },
  "features": {
    "aiAgents": true,
    "phaseTracking": true
  },
  "templates": {
    "default": "spec-template.md",
    "minimal": "spec-template.md",
    "standard": "standard-template.md",
    "detailed": "detailed-template.md"
  },
  "phases": {
    "enabled": true,
    "sequence": [
      "PREWORK",
      "REQUIREMENTS",
      "DESIGN",
      "PLAN",
      "IMPLEMENTATION",
      "ACCEPTANCE",
      "COMPLETE"
    ],
    "qaRequired": true
  }
}